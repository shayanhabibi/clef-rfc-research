<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Site.fs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Partas.Nacara.Theme asks for FSharp.Core 11. -->
        <PackageReference Include="FSharp.Core" Version="11.0.101-rc1.26425.128" />
        <PackageReference Include="FSharp.Data.Rocq" Version="0.1.0-preview.3" />
        <PackageReference Include="Nacara.Core" Version="2.0.0-beta.6" />
        <PackageReference Include="Nacara.Plugin.Markdown" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Highlight.TreeSitter" Version="1.0.0-beta.3" />
        <PackageReference Include="Nacara.Plugin.LinkValidator" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Rocq" Version="0.1.0-preview.3" />
        <PackageReference Include="Partas.Nacara.Theme" Version="0.3.0" />
    </ItemGroup>

</Project>
